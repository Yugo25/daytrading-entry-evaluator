generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Weekly journal page (equivalent to a Notion page like "8/23-8/28 +0.84")
model Week {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  theme     String?  // weekly theme (e.g. Wait patiently until the fish bites. Waiting is the job.)
  review    String?  // weekly review (free text / AI report)
  trades    Trade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startDate])
}

// An entry candidate submitted for evaluation
model Setup {
  id          String   @id @default(cuid())
  strategyId  String   // "ema200" | "ema20" ...
  pair        String
  direction   String?  // LONG | SHORT (optional → read by the AI)
  execTf      String   // execution timeframe 5m | 1h
  notes       String?  // user notes (self-analysis / entry rationale)
  numericData String?  // JSON: numeric inputs such as A/B/E/X (optional)
  images      SetupImage[]
  evaluations Evaluation[]
  trade       Trade?
  createdAt   DateTime @default(now())
}

model SetupImage {
  id       String @id @default(cuid())
  setupId  String
  setup    Setup  @relation(fields: [setupId], references: [id], onDelete: Cascade)
  role     String // EXEC (execution TF) | HIGHER (higher TF) | OTHER
  path     String // relative path in storage
  mimeType String
  order    Int    @default(0)
}

// AI evaluation result (compliance with the strategy criteria)
model Evaluation {
  id              String   @id @default(cuid())
  setupId         String
  setup           Setup    @relation(fields: [setupId], references: [id], onDelete: Cascade)
  strategyId      String
  strategyVersion String   // hash of the strategy docs at evaluation time (to track criteria)
  model           String
  structured      String   // JSON: EvaluationOutput
  rendered        String   // Markdown following the template
  overallScore    Int
  overallLabel    String
  fewShotIds      String   // JSON: array of Review IDs used as examples
  inputTokens     Int?
  outputTokens    Int?
  review          Review?
  createdAt       DateTime @default(now())
}

// The user's correction of an evaluation = training data for the evaluator
model Review {
  id                String     @id @default(cuid())
  evaluationId      String     @unique
  evaluation        Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  agree             Boolean    // whether the user agrees with the AI evaluation
  correctedScore    Int?       // correct overall score (when disagreeing)
  correctedElements String?    // JSON: { S1: "○", K4: "×", ... } corrected elements only
  comment           String     // why it is wrong / what was missed (most important)
  useAsExample      Boolean    @default(true) // whether to use as a calibration example
  createdAt         DateTime   @default(now())
}

// Trade record (journal row). May or may not be linked to an evaluation
model Trade {
  id               String    @id @default(cuid())
  weekId           String?
  week             Week?     @relation(fields: [weekId], references: [id])
  setupId          String?   @unique
  setup            Setup?    @relation(fields: [setupId], references: [id])
  journalNo        Int?      // sequence number within the week (the "1" in "1. EURAUD")
  date             DateTime  // entry time
  holdTime         String?   // 4h / 11h35m / 1d10h
  pair             String
  strategyId       String    // Type: ema200 / ema20
  execTf           String    // TF: 5m / 1h
  lineGrade        String?   // Line: S / A / B / None
  aoiGrade         String?   // AOI: S / A / B / None
  outcome          String    // WIN | BE | LOSS
  riskPct          Float?    // 0.5
  rrr              Float?    // 1.5
  resultPct        Float?    // -0.49
  market           String?   // Tokyo | London | NY
  ruleCompliance   Boolean   @default(true)
  violationContent String?
  violationMotive  String?
  analysis         String?   // analysis
  psychology       String?   // psychology
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
